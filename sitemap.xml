---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign sitemap_pages = site.html_pages | where_exp: "item", "item.url != '/404.html'" %}
  {% for item in sitemap_pages %}
    <url>
      <loc>{{ item.url | absolute_url }}</loc>
      <lastmod>{% if item.last_modified_at %}{{ item.last_modified_at | date_to_xmlschema }}{% elsif item.date %}{{ item.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
    </url>
  {% endfor %}
  {% for item in site.schools %}
    <url>
      <loc>{{ item.url | absolute_url }}</loc>
      <lastmod>{% if item.last_modified_at %}{{ item.last_modified_at | date_to_xmlschema }}{% elsif item.date %}{{ item.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
    </url>
  {% endfor %}
  {% for item in site.internships %}
    <url>
      <loc>{{ item.url | absolute_url }}</loc>
      <lastmod>{% if item.last_modified_at %}{{ item.last_modified_at | date_to_xmlschema }}{% elsif item.date %}{{ item.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
    </url>
  {% endfor %}
</urlset>
